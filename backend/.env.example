# Copy this file to backend/.env and fill it in locally.
# backend/.env is gitignored. Do not put a real key in this example.

# ollama or openai_compatible
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Used when LLM_PROVIDER=openai_compatible.
# LLM_BASE_URL includes the version prefix, for example https://api.example.com/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30

# Loopback is the default. Use 0.0.0.0 only for a device on a trusted network.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
