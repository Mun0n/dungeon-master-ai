        {
          "id": "recent_killings",
          "prompt": "¿A quién culpa la frase de los asesinatos recientes?",
          "options": [
            { "id": "alden", "gloss": "Culpa a Padre Aldren." },
            { "id": "beltran", "gloss": "Culpa a Don Beltrán." },
            { "id": "mara", "gloss": "Culpa a Mara." },
            { "id": "tomas", "gloss": "Culpa a Tomás." },
            { "id": "creature", "gloss": "Culpa a la criatura de la taberna." },
            { "id": "unknown", "gloss": "No atribuye los asesinatos a nadie." }
          ],
          "accept": ["alden"],
          "falseValues": ["beltran", "mara", "tomas", "creature"]
        },
        {
          "id": "confinement",
          "prompt": "¿Qué dice la frase que ocurrió con las personas sanas durante la epidemia?",
          "options": [
            { "id": "shut_in_with_the_sick", "gloss": "Encerró a personas sanas con los enfermos." },
