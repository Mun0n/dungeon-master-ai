    },
    {
      "id": "clerk",
      "name": "Clerk",
      "states": ["present"],
      "initialState": "present"
    }
  ],
  "items": [
    { "id": "brass_key", "name": "Brass Key" },
    { "id": "bandage", "name": "Bandage" },
    { "id": "pack_1", "name": "Pack One" },
    { "id": "pack_2", "name": "Pack Two" },
    { "id": "pack_3", "name": "Pack Three" },
    { "id": "pack_4", "name": "Pack Four" },
    { "id": "pack_5", "name": "Pack Five" }
  ],
  "flags": [
    { "id": "door_open", "default": false },
    { "id": "keeper_spared", "default": false },
    { "id": "hatch_open", "default": false },
    { "id": "truth_known", "default": false },
    { "id": "truth_public", "default": false },
    { "id": "chose_violence", "default": false },
    { "id": "chose_silence", "default": false },
    { "id": "gave_up", "default": false },
    { "id": "climbed", "default": false }
