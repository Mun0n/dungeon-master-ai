    {
      "id": "act_arrival",
      "title": "Arrival",
      "locationIds": ["yard", "hall"]
    },
    {
      "id": "act_below",
      "title": "Below",
      "locationIds": ["cellar"]
    }
  ],
  "locations": [
    { "id": "yard", "name": "Yard", "actId": "act_arrival" },
    { "id": "hall", "name": "Hall", "actId": "act_arrival" },
    { "id": "cellar", "name": "Cellar", "actId": "act_below" }
