  ],
  "endings": [
    {
      "id": "justice",
      "requirements": {
        "flagIds": ["truth_known", "truth_public"],
        "evidenceIds": ["proof_archive", "proof_crypt", "proof_notes", "proof_mark"]
      }
    },
    {
      "id": "vengeance",
      "requirements": {
        "flagIds": ["truth_known", "chose_violence"]
      }
    },
    {
      "id": "silence",
      "requirements": {
        "flagIds": ["truth_known", "chose_silence"]
      }
    },
    {
      "id": "failure",
      "requirements": {
        "flagIds": ["gave_up"]
      }
    },
    {
      "id": "death",
      "requirements": {}
    }
  ],
  "events": [
    {
      "id": "bells",
      "effects": [
        { "type": "SET_NPC_STATE", "npcId": "warden", "state": "lost" }
