  "evidences": [
    { "id": "proof_archive", "text": "A copied shelf entry." },
    { "id": "proof_crypt", "text": "A marked cellar sample." },
    { "id": "proof_notes", "text": "A set of working notes." },
    { "id": "proof_mark", "text": "A matching mark." }
  ],
  "clues": [
    { "id": "clue_bell", "text": "The yard bell is a test clue." },
    { "id": "clue_name", "text": "The clerk repeats a test name." }
  ],
  "deductions": [
    {
      "id": "named_conclusion",
      "evidenceIds": ["proof_archive", "proof_crypt", "proof_notes", "proof_mark"],
      "flag": "truth_known"
